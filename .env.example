# Local runtime
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DEMO_MODE=true

# Persistence
DATABASE_URL=file:./dev.db

# Optional NEAR AI Cloud integration
NEAR_AI_CLOUD_API_KEY=
NEAR_AI_CLOUD_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_CLOUD_MODEL=

# Optional NEAR Intents / 1Click integration
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com/v0
NEAR_INTENTS_JWT=
NEAR_INTENTS_ORIGIN_ASSET_ID=
NEAR_INTENTS_DESTINATION_ASSET_ID=
NEAR_INTENTS_ORIGIN_ASSET_DECIMALS=6
NEAR_INTENTS_DESTINATION_ASSET_DECIMALS=6
NEAR_INTENTS_ORIGIN_CHAIN=near
NEAR_INTENTS_DESTINATION_CHAIN=base
NEAR_INTENTS_TEST_RECIPIENT=
NEAR_INTENTS_REFUND_TO=treasury.covendro.testnet

# Optional read-only NEAR treasury verification (never a private key)
NEAR_TREASURY_ACCOUNT_ID=
NEAR_TREASURY_RPC_URL=https://rpc.mainnet.near.org

# Set together for an HTTPS, same-site authenticated workspace.
# Run database migrations without demo seed data for this mode.
NEXT_PUBLIC_COVENDRO_PILOT=false

# Live attempts are opt-in for one explicitly named pilot workspace.
PILOT_LIVE_WORKSPACE_SLUG=
PILOT_MAX_DEBIT_MINOR=
PILOT_NEAR_USDC_CONTRACT=
PILOT_BASE_USDC_CONTRACT=
NEAR_INTENTS_API_KEY=
# Enable only after the reconciliation worker is deployed and the canary is authorized.
PILOT_ENABLE_WALLET_HANDOFF=false
